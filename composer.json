{
    "name": "spryker-academy/api-platform-course",
    "description": "Spryker Academy - Building APIs in Spryker with API Platform: the Supplier module suite the video course starts from, and one branch per lesson with the API built step by step",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Spryker Academy",
            "email": "academy@spryker.com"
        }
    ],
    "keywords": [
        "spryker",
        "training",
        "api-platform",
        "supplier",
        "storefront-api",
        "backend-api"
    ],
    "require": {
        "php": ">=8.3",
        "spryker/kernel": "^3.0.0",
        "spryker/symfony": "^3.0.0",
        "spryker/gui": "^3.0.0 || ^4.0.0",
        "spryker/propel-orm": "^1.0.0",
        "spryker/data-import": "^1.0.0",
        "spryker/search": "^8.0.0",
        "spryker/search-elasticsearch": "^1.0.0",
        "spryker/storage": "^3.0.0",
        "spryker/synchronization": "^1.0.0",
        "spryker/publisher": "^1.0.0",
        "spryker/publisher-extension": "^1.0.0",
        "spryker/event-behavior": "^1.0.0",
        "spryker/api-platform": "^1.25.0",
        "spryker/oms": "^11.0.0",
        "spryker/oms-extension": "^1.0.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/testify": "*"
    },
    "autoload": {
        "psr-4": {
            "SprykerAcademy\\": "src/SprykerAcademy/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerAcademyTest\\": "tests/SprykerAcademyTest/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
